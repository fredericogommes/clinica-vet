# Copie para .env e ajuste. Nunca versione o .env real.
NODE_ENV=development
DATABASE_URL=postgres://clinica:troque-esta-senha@127.0.0.1:5432/clinica_dev
API_HOST=127.0.0.1
API_PORT=3000
# Origem do frontend aceita por CORS.
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# WhatsApp Business pela API oficial da Meta. Sem token e número, as mensagens automáticas
# ficam na fila para a recepção enviar pelo WhatsApp da clínica.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Minutos entre as rodadas de geração e envio das mensagens automáticas (0 desliga).
MESSAGES_INTERVAL_MINUTES=5

# Usados apenas por `npm run db:seed` para criar a primeira organização e o administrador.
SEED_ORGANIZATION_NAME="Clínica Exemplo"
SEED_UNIT_NAME=Matriz
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-forte

# Testes de integração: conexão com permissão de CREATE DATABASE.
TEST_DATABASE_ADMIN_URL=postgres://clinica:troque-esta-senha@127.0.0.1:5432/postgres

# Somente docker-compose (produção).
POSTGRES_PASSWORD=troque-esta-senha
# Domínio público; o Caddy emite o certificado HTTPS automaticamente. Use :80 para testes locais.
SITE_ADDRESS=clinica.exemplo.com.br
