{
  "name": "clinica-vet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @clinica/contracts && npm run build -w @clinica/api && npm run build -w @clinica/web",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @clinica/api && npm run test -w @clinica/web",
    "test:e2e": "npm run test:e2e -w @clinica/web",
    "db:migrate": "npm run db:migrate -w @clinica/api",
    "db:seed": "npm run db:seed -w @clinica/api",
    "dev:api": "npm run dev -w @clinica/api",
    "dev:web": "npm run dev -w @clinica/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
